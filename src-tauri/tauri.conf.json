{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corelume",
  "version": "1.0.0",
  "identifier": "dev.corelume.monitor",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Corelume",
        "width": 1040,
        "height": 840,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#0c0e11"
      }
    ],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "A light, good-looking system monitor dashboard",
    "resources": { "../vendor/pawnio/PawnIO_setup.exe": "PawnIO_setup.exe" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
